# ─────────────────────────────────────────────────────────────
# SynthBoard environment configuration
# Copy to `.env` and fill in the values, then `docker compose up`.
# ─────────────────────────────────────────────────────────────

# Public URL the app is served from (used for OAuth callbacks + CORS).
# For local docker-compose this is the nginx (client) port.
APP_URL=http://localhost:8080

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=synthboard
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=synthboard
# Connection string used by the server. Host is the compose service name.
DATABASE_URL=postgres://synthboard:change-me-in-production@db:5432/synthboard

# ── Session ───────────────────────────────────────────────────
# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM (diagram generation, NVIDIA OpenAI-compatible API) ────
# API key from https://build.nvidia.com
NVIDIA_API_KEY=
# Optional overrides:
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=minimaxai/minimax-m2.7
LLM_MAX_TOKENS=8192

# ── Quota ─────────────────────────────────────────────────────
# Max visualizations a single account may generate.
MAX_VISUALIZATIONS_PER_ACCOUNT=5
