# ─────────────────────────────────────────────────────────────
# SynthBoard environment configuration
# Copy to `.env` and fill in the values, then `docker compose up`.
# ─────────────────────────────────────────────────────────────

# Public URL the app is served from (used for OAuth callbacks + CORS).
# For local docker-compose this is the nginx (client) port.
APP_URL=http://localhost:8080

# ── Postgres ──────────────────────────────────────────────────
# These POSTGRES_* vars are only used by the bundled `db` container in
# docker-compose.yml. With a managed/external database (see
# docker-compose.managed-db.yml) you can omit them and just set DATABASE_URL.
POSTGRES_USER=synthboard
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=synthboard
# Connection string used by the server. For the bundled container the host is
# the compose service name `db`. For a managed database, point it at your
# provider, e.g.
#   DATABASE_URL=postgres://user:pass@db-host:5432/dbname
DATABASE_URL=postgres://synthboard:change-me-in-production@db:5432/synthboard
# Set to true when using a managed Postgres that requires TLS (most do).
# Leave unset/false for the local bundled container.
DATABASE_SSL=false

# ── Session ───────────────────────────────────────────────────
# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM providers ─────────────────────────────────────────────
# Provider key values stay in environment variables. The admin panel stores
# only the variable name, provider endpoint, model id, model parameters, and
# minimum account level. Add any provider-specific key names you configure in
# Admin → AI models. Docker Compose passes this whole file to the server.
#
# Initial NVIDIA key from https://build.nvidia.com:
NVIDIA_API_KEY=
# Examples for additional OpenAI-compatible providers:
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
#
# One-time seed values for the initial NVIDIA provider/model catalog. After the
# first successful boot, manage endpoints, models, level access, and max output
# tokens in Admin → AI models.
LLM_API_KEY_ENV=NVIDIA_API_KEY
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=minimaxai/minimax-m2.7
LLM_MAX_TOKENS=8192
# Abort an upstream LLM call after this many ms (keep it below your reverse
# proxy's read timeout so failures log clearly instead of returning a 504).
LLM_TIMEOUT_MS=280000
# Retries off by default — retrying a slow reasoning model just burns another
# full timeout window.
LLM_MAX_RETRIES=0

# ── Quota ─────────────────────────────────────────────────────
# Seeds the Level 1 (Sketcher) quota. Accounts have a membership level
# (1 Sketcher / 2 Creator / 3 Architect / 4 Visionary); new users start at
# Level 1. Each level's limit and a user's level are editable in the admin panel.
MAX_VISUALIZATIONS_PER_ACCOUNT=5

# ── Admin ─────────────────────────────────────────────────────
# Comma-separated emails granted admin on login. Use this to bootstrap the
# first administrator; further admins can be promoted from the admin panel.
ADMIN_EMAILS=
