# ─────────────────────────────────────────────────────────────
# SynthBoard environment configuration
# Copy to `.env` and fill in the values, then `docker compose up`.
# ─────────────────────────────────────────────────────────────

# Public URL the app is served from (used for OAuth callbacks + CORS).
# For local docker-compose this is the nginx (client) port.
APP_URL=http://localhost:8080

# ── Postgres ──────────────────────────────────────────────────
# These POSTGRES_* vars are only used by the bundled `db` container in
# docker-compose.yml. With a managed/external database (see
# docker-compose.managed-db.yml) you can omit them and just set DATABASE_URL.
POSTGRES_USER=synthboard
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=synthboard
# Connection string used by the server. For the bundled container the host is
# the compose service name `db`. For a managed database, point it at your
# provider, e.g.
#   DATABASE_URL=postgres://user:pass@db-host:5432/dbname
DATABASE_URL=postgres://synthboard:change-me-in-production@db:5432/synthboard
# Set to true when using a managed Postgres that requires TLS (most do).
# Leave unset/false for the local bundled container.
DATABASE_SSL=false

# ── Session ───────────────────────────────────────────────────
# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM (diagram generation, NVIDIA OpenAI-compatible API) ────
# API key from https://build.nvidia.com
NVIDIA_API_KEY=
# Optional initial values. These seed the runtime settings on first boot; after
# that they're editable from the admin panel (Settings tab) without a redeploy.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=minimaxai/minimax-m2.7
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=1
LLM_TOP_P=0.95

# ── Quota ─────────────────────────────────────────────────────
# Max visualizations a single account may generate (also editable in admin).
MAX_VISUALIZATIONS_PER_ACCOUNT=5

# ── Admin ─────────────────────────────────────────────────────
# Comma-separated emails granted admin on login. Use this to bootstrap the
# first administrator; further admins can be promoted from the admin panel.
ADMIN_EMAILS=
