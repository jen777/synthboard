# ─────────────────────────────────────────────────────────────
# SynthBoard — Azure deployment configuration
# Copy to `azure/.env.azure`, fill in the values, then run:
#   ./azure/deploy.sh
# (azure/.env.azure is gitignored — never commit real secrets.)
# ─────────────────────────────────────────────────────────────

# ── Azure placement ───────────────────────────────────────────
# IMPORTANT: pick FIXED names (don't use $RANDOM). The script is idempotent and
# re-uses existing resources by name, so re-running won't create duplicates.
# ACR_NAME and PG_SERVER_NAME must be GLOBALLY unique — change the "synthboard"
# part below to something distinctive (e.g. your initials/org) once.
RESOURCE_GROUP=synthboard-rg
LOCATION=eastus
# ACR name: lowercase letters/numbers only, 5–50 chars, globally unique.
ACR_NAME=synthboardacr
CONTAINERAPP_ENV=synthboard-env
CONTAINERAPP_NAME=synthboard
IMAGE_TAG=latest

# ── Postgres Flexible Server ──────────────────────────────────
# Server name must be globally unique (becomes <name>.postgres.database.azure.com).
PG_SERVER_NAME=synthboard-pg
PG_ADMIN_USER=synthadmin
# Strong password. Use a URL-safe generator so it embeds cleanly in DATABASE_URL
# (avoid base64, which yields / + = ). Generate with: openssl rand -hex 24
# (The deploy script also percent-encodes it, so any password works either way.)
PG_ADMIN_PASSWORD=
PG_DB_NAME=synthboard
# Cheapest burstable tier; bump for production.
PG_SKU=Standard_B1ms
PG_TIER=Burstable
PG_STORAGE_GB=32
PG_VERSION=16

# ── Custom domain + Cloudflare (used only by azure/custom-domain.sh) ──
# The public hostname you'll serve from, e.g. app.example.com or example.com.
CUSTOM_DOMAIN=
# Paths to the Cloudflare *Origin Certificate* and its private key (PEM files
# you download/generate in the Cloudflare dashboard: SSL/TLS → Origin Server →
# Create Certificate). Leave blank if you're not binding a custom domain yet.
ORIGIN_CERT_FILE=
ORIGIN_KEY_FILE=

# ── Application secrets / config (become Container App env vars) ──
# APP_URL is set automatically to the Container App's HTTPS FQDN after the first
# deploy — leave it blank here. If you wire up a custom domain, set it explicitly.
APP_URL=

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# After the first deploy, add ${APP_URL}/auth/google/callback as an Authorized
# redirect URI (the script prints the exact value), then re-run or update.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Initial NVIDIA provider key — https://build.nvidia.com. Add later provider
# keys as Container App secrets as documented in azure/README.md.
NVIDIA_API_KEY=

# One-time initial provider/model seed. Manage the catalog later in
# Admin → AI models.
LLM_API_KEY_ENV=NVIDIA_API_KEY
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=minimaxai/minimax-m2.7
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=280000
LLM_MAX_RETRIES=0

# Per-account visualization quota.
MAX_VISUALIZATIONS_PER_ACCOUNT=5

# Comma-separated emails granted admin on login (bootstraps the first admin).
ADMIN_EMAILS=
